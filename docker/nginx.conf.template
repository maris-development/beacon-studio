server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    # Keep redirects relative, so they work behind a proxy on another port or host.
    absolute_redirect off;

    gzip on;
    gzip_types text/css application/javascript application/json application/wasm image/svg+xml;
    gzip_min_length 1024;

    # File names under _app/immutable hold a content hash.
    location ${BASE_PATH}/_app/immutable/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # SPA fallback: the client router resolves every other path.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ ${BASE_PATH}/index.html;
    }
}
